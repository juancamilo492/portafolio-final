---
import Icono from './Icono.astro';
import { useTranslations, type Alternativa } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  alternativas: Alternativa[];
}

const { locale, alternativas } = Astro.props;
const t = useTranslations(locale);
const id = 'menu-idioma';

/*
 * El código del idioma abre el nombre accesible porque es lo único que se lee
 * en el botón: quien navega por voz dicta lo que ve —«ES»— y el nombre tiene
 * que contenerlo (WCAG 2.5.3, Label in Name).
 */
const etiquetaDisparador = `${locale.toUpperCase()} — ${t('nav.selectorIdioma')}`;

/*
 * Sin `aria-haspopup`: lo que se despliega es una lista de enlaces, no un menú
 * de aplicación con `role="menu"`, y anunciarlo como menú promete una
 * navegación que estos enlaces no tienen. `aria-expanded` + `aria-controls`
 * describen exactamente lo que hace el botón. Las flechas siguen funcionando
 * como atajo, que no estorba a nadie.
 */
---

<div class="relative" data-selector-idioma>
  <button
    type="button"
    data-disparador
    aria-expanded="false"
    aria-controls={id}
    aria-label={etiquetaDisparador}
    class="flex items-center gap-[7px] rounded-full border border-borde-medio py-[7px] pr-3 pl-[11px] text-xs font-semibold tracking-[.04em] text-bosque transition-colors hover:border-acento hover:text-acento-texto dark:border-borde-noche dark:text-noche-titulo dark:hover:border-menta dark:hover:text-menta"
  >
    <Icono nombre="globo" tamano={15} />
    <span>{locale.toUpperCase()}</span>
    <Icono nombre="caret" tamano={9} />
  </button>

  <div
    id={id}
    data-menu
    hidden
    class="absolute top-[calc(100%+10px)] right-0 z-60 flex min-w-[180px] flex-col gap-0.5 rounded-menu border border-borde bg-superficie p-1.5 shadow-menu dark:border-borde-noche dark:bg-noche-superficie"
  >
    {
      alternativas.map((alt) => {
        const activa = alt.locale === locale;
        return (
          <a
            href={alt.href}
            hreflang={alt.locale}
            lang={alt.locale}
            aria-current={activa ? 'true' : undefined}
            class:list={[
              'flex items-center justify-between gap-3 rounded-[9px] px-3 py-2 text-sm transition-colors',
              activa
                ? 'bg-acento/10 font-semibold text-profundo dark:text-noche-titulo'
                : 'font-normal text-texto-cuerpo hover:bg-acento/10 hover:text-profundo dark:text-noche-cuerpo dark:hover:text-noche-titulo',
            ]}
          >
            <span>{alt.nombre}</span>
            <span class="text-[11px] tracking-[.08em] opacity-60">
              {alt.locale.toUpperCase()}
            </span>
          </a>
        );
      })
    }
  </div>
</div>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-selector-idioma]')) {
    const disparador = raiz.querySelector<HTMLButtonElement>('[data-disparador]');
    const menu = raiz.querySelector<HTMLElement>('[data-menu]');
    if (!disparador || !menu) continue;

    const opciones = () => [...menu.querySelectorAll<HTMLAnchorElement>('a')];

    function abrir(enfocarPrimera = false) {
      menu!.hidden = false;
      disparador!.setAttribute('aria-expanded', 'true');
      if (enfocarPrimera) opciones()[0]?.focus();
    }

    function cerrar(devolverFoco = false) {
      menu!.hidden = true;
      disparador!.setAttribute('aria-expanded', 'false');
      if (devolverFoco) disparador!.focus();
    }

    disparador.addEventListener('click', () => {
      menu.hidden ? abrir() : cerrar();
    });

    // Flechas desde el disparador: abre y entra al menú.
    disparador.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowDown' || evento.key === 'ArrowUp') {
        evento.preventDefault();
        abrir(true);
      }
    });

    // Navegación con flechas dentro del menú.
    menu.addEventListener('keydown', (evento) => {
      const lista = opciones();
      const actual = lista.indexOf(document.activeElement as HTMLAnchorElement);
      if (evento.key === 'ArrowDown') {
        evento.preventDefault();
        lista[(actual + 1) % lista.length]?.focus();
      } else if (evento.key === 'ArrowUp') {
        evento.preventDefault();
        lista[(actual - 1 + lista.length) % lista.length]?.focus();
      } else if (evento.key === 'Home') {
        evento.preventDefault();
        lista[0]?.focus();
      } else if (evento.key === 'End') {
        evento.preventDefault();
        lista[lista.length - 1]?.focus();
      }
    });

    // Escape cierra y devuelve el foco al disparador.
    raiz.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !menu.hidden) {
        evento.stopPropagation();
        cerrar(true);
      }
    });

    // Clic fuera y foco fuera cierran el menú.
    document.addEventListener('click', (evento) => {
      if (!menu.hidden && !raiz.contains(evento.target as Node)) cerrar();
    });
    document.addEventListener('focusin', (evento) => {
      if (!menu.hidden && !raiz.contains(evento.target as Node)) cerrar();
    });
  }
</script>
