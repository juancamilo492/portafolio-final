/**
 * Logos de las herramientas que aparecen en «Sobre mí».
 *
 * Van en `currentColor` como el resto de los iconos del sitio (`Icono.astro`,
 * `Logo.astro`): así toman el color del chip y sirven igual en modo claro y
 * oscuro, sin mantener una versión por tema. Los trazos son sólidos —son logos,
 * no iconos lineales—, de ahí el `fill` en vez del `stroke`.
 *
 * Los paths se copiaron de Simple Icons (CC0) en vez de instalar el paquete o
 * pedirlos a un CDN: el SVG queda en línea en el HTML, sin una sola petición
 * extra ni JavaScript, que es la única forma de sumar diez logos sin tocar el
 * rendimiento. Son marcas de sus dueños y aquí se usan para nombrar la
 * herramienta.
 *
 * Microsoft Clarity no tiene logo propio en la librería: lleva el de Microsoft.
 */
export type NombreHerramienta =
  | 'figma'
  | 'n8n'
  | 'clarity'
  | 'hotjar'
  | 'unity'
  | 'blender'
  | 'photoshop'
  | 'illustrator'
  | 'premiere'
  | 'clickup';

interface Props {
  nombre: NombreHerramienta;
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 13, class: clase } = Astro.props;

const comun = {
  width: tamano,
  height: tamano,
  viewBox: '0 0 24 24',
  fill: 'currentColor',
  'aria-hidden': true,
  focusable: 'false',
  class: clase,
};
