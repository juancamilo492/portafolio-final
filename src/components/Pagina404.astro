---
/**
 * Cuerpo de la página 404, compartido por las rutas que la publican:
 * `src/pages/404.astro` (raíz, en español) y `src/pages/[lang]/404.astro`
 * (una por idioma activo). Cloudflare Pages busca el `404.html` más cercano
 * subiendo por el árbol de directorios, así que un visitante que se pierda
 * dentro de /fr/ recibe la francesa y solo quien se pierda fuera de todo
 * prefijo de idioma cae en la de la raíz.
 */
import Boton from './Boton.astro';
import Contenedor from './Contenedor.astro';
import MarcaGeometrica from './MarcaGeometrica.astro';
import TarjetaProyecto from './TarjetaProyecto.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { rutaDe, useTranslations } from '../i18n/utils';
import { proyectosDestacados } from '../lib/proyectos';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Si el idioma no tiene proyectos, la franja de sugerencias simplemente no
// aparece: una 404 no es el lugar para un marcador de trabajo pendiente.
const sugerencias = await proyectosDestacados(locale, 3);
---

<BaseLayout
  locale={locale}
  titulo={t('meta.404.titulo')}
  descripcion={t('meta.404.descripcion')}
  noindex
>
  <section class="ondas [--ondas-radio:52px] [--ondas-x:50%] [--ondas-y:30%] overflow-hidden">
    <div
      class="mx-auto flex max-w-[820px] flex-col items-center px-5 py-24 text-center md:px-10 md:py-[130px]"
    >
      <MarcaGeometrica tamano={26} class="mb-[26px] text-acento dark:text-menta" />
      <p
        class="font-titular text-[72px] leading-none tracking-[-.04em] text-profundo sm:text-[96px] dark:text-noche-titulo"
      >
        404
      </p>
      <h1 class="mt-[22px] text-[30px] leading-[1.12] tracking-[-.02em] sm:text-[40px]">
        {t('404.titulo')}
      </h1>
      <p
        class="mt-4 max-w-[440px] text-[17px] leading-relaxed font-light text-texto-cuerpo dark:text-noche-cuerpo"
      >
        {t('404.descripcion')}
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3.5">
        <Boton href={rutaDe(locale)}>{t('404.volver')}</Boton>
        <Boton href={rutaDe(locale, 'proyectos')} variante="contorno">
          {t('404.verProyectos')}
        </Boton>
      </div>
    </div>
  </section>

  {
    sugerencias.length > 0 && (
      <Contenedor as="section" class="pb-4">
        <h2 class="mb-6 font-cuerpo text-[11.5px] font-semibold tracking-[.13em] text-texto-tenue uppercase dark:text-noche-cuerpo">
          {t('404.quizaBuscabas')}
        </h2>
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {sugerencias.map((proyecto) => (
            <li>
              <TarjetaProyecto proyecto={proyecto} locale={locale} variante="compacta" />
            </li>
          ))}
        </ul>
      </Contenedor>
    )
  }
</BaseLayout>
