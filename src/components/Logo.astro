---
/**
 * La marca: el oso de Juan Camilo. Reemplaza al monograma «JC» en el header
 * y en el footer, y es el mismo dibujo que el favicon.
 *
 * Va en `currentColor` como el resto de los iconos del sistema, no en el
 * turquesa del archivo original: así toma el color que le toca en cada sitio
 * —claro sobre el cuadrado verde profundo, y el que haga falta si algún día se
 * usa suelto— sin tener que mantener una versión por fondo.
 *
 * Decorativo por defecto: quien lo envuelve (el enlace al inicio) ya lleva su
 * propio nombre accesible.
 *
 * Las dos formas son el hocico y la cabeza, y no se tocan: el hueco entre
 * ellas es parte del dibujo. Por eso el color de fondo tiene que verse a
 * través, y el SVG no lleva relleno propio más allá de `currentColor`.
 *
 * Fuente: `src/assets/marca/logo.svg` (162 × 130).
 */
interface Props {
  /** Ancho en píxeles. El alto sale de la proporción del dibujo. */
  ancho?: number;
  class?: string;
}

const { ancho = 22, class: clase } = Astro.props;

const ANCHO_ORIGINAL = 162;
const ALTO_ORIGINAL = 130;
const alto = Math.round((ancho * ALTO_ORIGINAL) / ANCHO_ORIGINAL);
---

<svg
  width={ancho}
  height={alto}
  viewBox="0 0 162 130"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={clase}
