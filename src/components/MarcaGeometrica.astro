---
/**
 * Marca geométrica de la firma visual: una mira de trazo fino.
 * Reemplaza a las estrellas de 4 puntas del brief original (ver handoff).
 * Siempre decorativa — nunca lleva significado propio.
 */
interface Props {
  tamano?: number;
  class?: string;
}

const { tamano = 24, class: clase } = Astro.props;
---

<svg
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  aria-hidden="true"
  focusable="false"
  class={clase}
>
  <circle cx="12" cy="12" r="7"></circle>
  <path d="M12 1v5M12 18v5M1 12h5M18 12h5" stroke-linecap="round"></path>
</svg>
