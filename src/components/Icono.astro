---
/**
 * Íconos lineales del sistema (trazo 1.4–1.7px, `currentColor`).
 * Decorativos por defecto: el texto o el aria-label del contenedor los describe.
 */
export type NombreIcono =
  | 'globo'
  | 'caret'
  | 'luna'
  | 'sol'
  | 'correo'
  | 'whatsapp'
  | 'descargar'
  | 'linkedin'
  | 'menu'
  | 'cerrar'
  | 'flecha-derecha'
  | 'flecha-abajo'
  | 'flecha-arriba'
  | 'enlace-externo'
  | 'panel'
  | 'chispa'
  | 'ojo'
  | 'copiar'
  | 'chulo'
  | 'info';

interface Props {
  nombre: NombreIcono;
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 16, class: clase } = Astro.props;

const comun = {
  width: tamano,
  height: tamano,
  viewBox: '0 0 24 24',
  'aria-hidden': true,
  focusable: 'false',
  class: clase,
};

const trazo = { ...comun, fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6 };
---

{
  nombre === 'globo' && (
    <svg {...trazo} stroke-width="1.5">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" />
    </svg>
  )
}
{
  nombre === 'caret' && (
    <svg {...trazo} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="m5 9 7 7 7-7" />
    </svg>
  )
}
{
  nombre === 'luna' && (
    <svg {...trazo} stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
    </svg>
  )
}
{
  nombre === 'sol' && (
    <svg {...trazo} stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2v2.6M12 19.4V22M4.2 4.2l1.9 1.9M17.9 17.9l1.9 1.9M2 12h2.6M19.4 12H22M4.2 19.8l1.9-1.9M17.9 6.1l1.9-1.9" />
    </svg>
  )
}
{
  nombre === 'correo' && (
    <svg {...trazo} stroke-linecap="round" stroke-linejoin="round">
      <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
      <path d="m3 6 9 6.5L21 6" />
    </svg>
  )
}
{
  nombre === 'whatsapp' && (
    <svg {...comun} fill="currentColor">
      <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a12 12 0 0 1-5.9-5.1c-.4-.7-.9-1.7-.9-2.6 0-.9.5-1.4.7-1.6.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.2.1.4.1.6-.1l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.2.1.4.2.4.3v.9Z" />
    </svg>
  )
}
{
  nombre === 'descargar' && (
    <svg {...trazo} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M4 20h16" />
    </svg>
  )
}
{
  nombre === 'linkedin' && (
    <svg {...comun} fill="currentColor">
      <path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9.5h4v11H3v-11Zm6.5 0h3.8v1.5h.06a4.2 4.2 0 0 1 3.77-2.07c4.03 0 4.77 2.65 4.77 6.1v5.47h-4v-4.85c0-1.16-.02-2.65-1.61-2.65-1.62 0-1.87 1.26-1.87 2.56v4.94h-3.9v-11Z" />
    </svg>
  )
}
{
  nombre === 'menu' && (
    <svg {...trazo} stroke-width="1.8" stroke-linecap="round">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  )
}
{
  nombre === 'cerrar' && (
    <svg {...trazo} stroke-width="1.8" stroke-linecap="round">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  )
}
{
  nombre === 'flecha-derecha' && (
    <svg {...trazo} stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" />
    </svg>
  )
}
{
  nombre === 'flecha-abajo' && (
    <svg {...trazo} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v15M6 13l6 6 6-6" />
    </svg>
  )
}
{
  nombre === 'flecha-arriba' && (
    <svg {...trazo} stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20V5M6 11l6-6 6 6" />
    </svg>
  )
}
{
  /*
   * La caja abierta con la flecha que sale: el dibujo que ya espera cualquiera
   * para «esto se abre aparte». La caja queda abierta por la esquina superior
   * derecha a propósito, para que la flecha no la cruce a 15px.
   */
  nombre === 'enlace-externo' && (
    <svg {...trazo} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 4h6v6M20 4l-8.5 8.5" />
      <path d="M18.5 14.5v4A2.5 2.5 0 0 1 16 21H5.5A2.5 2.5 0 0 1 3 18.5V8A2.5 2.5 0 0 1 5.5 5.5h4" />
    </svg>
  )
}
{
  /* Los tres siguientes acompañan a las tarjetas de "Qué hago". */
}
{
  nombre === 'panel' && (
    <svg {...trazo} stroke-width="1.4">
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <path d="M3 9h18M9 21V9" />
    </svg>
  )
}
{
  nombre === 'chispa' && (
    <svg {...trazo} stroke-width="1.4" stroke-linecap="round">
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3" />
    </svg>
  )
}
{
  nombre === 'ojo' && (
    <svg {...trazo} stroke-width="1.4" stroke-linejoin="round">
      <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" />
      <circle cx="12" cy="12" r="2.5" />
    </svg>
  )
}
{
  nombre === 'copiar' && (
    <svg {...trazo} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="3.5" width="8" height="4" rx="1.1" />
      <path d="M8 5.5H6.8A2.3 2.3 0 0 0 4.5 7.8V18.2a2.3 2.3 0 0 0 2.3 2.3h10.4a2.3 2.3 0 0 0 2.3-2.3V7.8a2.3 2.3 0 0 0-2.3-2.3H16" />
    </svg>
  )
}
{
  nombre === 'chulo' && (
    <svg {...trazo} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m5 12.8 4.5 4.5L19 7" />
    </svg>
  )
}
{
  nombre === 'info' && (
    <svg {...trazo} stroke-linecap="round">
      <circle cx="12" cy="12" r="9" />
      <path d="M12 11v5.3" />
      <circle cx="12" cy="7.6" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
