---
/**
 * Botón "Descargar CV".
 *
 * Con un solo PDF disponible es un enlace directo: un desplegable de una sola
 * opción sería un clic de más. Cuando exista el CV en otro idioma vuelve a ser
 * un menú, y entonces lleva `data-selector-idioma` a propósito — es el mismo
 * patrón del selector de idioma del header y reutiliza su script (clic fuera,
 * Escape, flechas, aria-expanded) en lugar de duplicar esa lógica — incluida
 * su decisión de no declarar `aria-haspopup`: lo que se abre es una lista de
 * enlaces de descarga, no un menú con `role="menu"`.
 *
 * `variante="claro"` es para el pie: el botón vive sobre el verde profundo
 * (`bg-profundo`) sin importar el tema del sitio, así que usa el mismo
 * patrón que `claro-contorno` de Boton.astro en vez de los tokens de
 * `variante="normal"`, pensados para una superficie clara. El panel del
 * menú no cambia: sigue los tokens de tema normales, como cualquier
 * desplegable que flota sobre el fondo oscuro del pie.
 */
import Icono from './Icono.astro';
import { useTranslations } from '../i18n/utils';
import { CV, CV_IDIOMAS, cvDe, nombreArchivoCv } from '../config/sitio';
import { NOMBRE_LOCALE, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  variante?: 'normal' | 'claro';
}

const { locale, variante = 'normal' } = Astro.props;
const t = useTranslations(locale);
/*
 * El pie repite este componente en toda página que ya trae un `MenuCV` en el
 * cuerpo (inicio, Sobre mí): dos instancias con el mismo id romperían el
 * `aria-controls` de una de las dos. La variante ya es única por página, así
 * que basta para diferenciarlas sin generar un id al azar.
 */
const id = variante === 'claro' ? 'menu-cv-pie' : 'menu-cv';

// El idioma actual primero: es el PDF que casi siempre se busca.
const idiomas = [...CV_IDIOMAS].sort((a, b) => Number(b === locale) - Number(a === locale));
const unico = idiomas.length < 2 ? cvDe(locale) : undefined;

const variantes = {
  normal:
    'border-borde-fuerte text-profundo hover:border-acento hover:text-acento-texto dark:border-borde-noche dark:text-noche-titulo dark:hover:border-menta dark:hover:text-menta',
  claro: 'border-borde-claro-fuerte text-fondo hover:border-menta hover:text-menta',
};

const estiloBoton = `inline-flex items-center gap-[9px] rounded-full border border-dashed px-[22px] py-[15px] text-[14.5px] font-semibold transition-colors ${variantes[variante]}`;
---

{
  unico ? (
    <a
      href={unico.href}
      download={nombreArchivoCv(unico.idioma)}
      hreflang={unico.idioma}
      class={estiloBoton}
    >
      <Icono nombre="descargar" tamano={15} />
      {t('contacto.cv')}
      {/* El código del idioma evita la sorpresa de bajar un PDF en otra lengua. */}
      <span class="text-[11px] tracking-[.08em] opacity-60">{unico.idioma.toUpperCase()} · PDF</span>
    </a>
  ) : (
    <div class="relative" data-selector-idioma>
      <button
        type="button"
        data-disparador
        aria-expanded="false"
        aria-controls={id}
        class={estiloBoton}
      >
        <Icono nombre="descargar" tamano={15} />
        {t('contacto.cv')}
        <Icono nombre="caret" tamano={9} />
      </button>

      <div
        id={id}
        data-menu
        hidden
        class="absolute top-[calc(100%+10px)] left-0 z-60 flex min-w-[230px] flex-col gap-0.5 rounded-menu border border-borde bg-superficie p-1.5 shadow-menu dark:border-borde-noche dark:bg-noche-superficie"
      >
        <span class="px-3 pt-2 pb-1.5 text-[11px] tracking-[.12em] text-texto-tenue uppercase dark:text-noche-cuerpo">
          {t('inicio.cvIdioma')}
        </span>
        {idiomas.map((idioma) => (
          <a
            href={CV[idioma]}
            download={nombreArchivoCv(idioma)}
            hreflang={idioma}
            class="flex items-center justify-between gap-3 rounded-[9px] px-3 py-2 text-sm text-texto-cuerpo transition-colors hover:bg-acento/10 hover:text-profundo dark:text-noche-cuerpo dark:hover:text-noche-titulo"
          >
            <span>{NOMBRE_LOCALE[idioma]}</span>
            <span class="text-[11px] tracking-[.08em] opacity-60">PDF</span>
          </a>
        ))}
      </div>
    </div>
  )
}
