---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contenedor from '../components/Contenedor.astro';
import MarcaGeometrica from '../components/MarcaGeometrica.astro';
import { rutaDe, useTranslations } from '../i18n/utils';
import { DEFAULT_LOCALE } from '../i18n/ui';

// El host sirve un único 404 en la raíz; se muestra en el idioma por defecto.
const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  titulo={t('meta.404.titulo')}
  descripcion="[PENDIENTE: meta description de la página 404]"
>
  <section class="ondas [--ondas-radio:52px] [--ondas-x:50%] [--ondas-y:30%] overflow-hidden">
    <Contenedor class="py-32 text-center">
      <MarcaGeometrica class="mx-auto text-acento/60" />
      <p class="mt-8 font-titular text-[96px] leading-none tracking-[-.04em] text-profundo dark:text-noche-titulo">
        404
      </p>
      <h1 class="mt-2 text-3xl tracking-[-.02em] md:text-5xl">{t('404.titulo')}</h1>
      <p class="mx-auto mt-5 max-w-lg font-light text-texto-cuerpo dark:text-noche-cuerpo">
        {t('404.descripcion')}
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href={rutaDe(locale)}
          class="rounded-full bg-acento px-7 py-3.5 text-sm font-semibold text-sobre-acento transition-colors hover:bg-acento-hover"
        >
          {t('404.volver')}
        </a>
        <a
          href={rutaDe(locale, 'proyectos')}
          class="rounded-full border border-borde-fuerte px-7 py-3.5 text-sm font-semibold text-profundo transition-colors hover:border-acento hover:text-acento-texto dark:border-borde-noche dark:text-noche-titulo dark:hover:border-menta dark:hover:text-menta"
        >
          {t('404.verProyectos')}
        </a>
      </div>
      {/* FASE 3: franja "QUIZÁ BUSCABAS" con 3 tarjetas de proyecto. */}
    </Contenedor>
  </section>
</BaseLayout>
