---
import Pagina404 from '../components/Pagina404.astro';
import { DEFAULT_LOCALE } from '../i18n/ui';

/*
 * La 404 de la raíz, para quien se pierda fuera de todo prefijo de idioma
 * (/algo-que-no-existe). Va en español, que es el idioma por defecto. Las
 * versiones por idioma viven en `src/pages/[lang]/404.astro` y Cloudflare
 * Pages las prefiere: busca el `404.html` más cercano subiendo por el árbol.
 */
---

<Pagina404 locale={DEFAULT_LOCALE} />
