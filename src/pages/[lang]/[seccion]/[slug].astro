---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Contenedor from '../../../components/Contenedor.astro';
import { segmento, useTranslations } from '../../../i18n/utils';
import { LOCALES_ACTIVOS } from '../../../i18n/ui';
import { localeDeEntrada, proyectosPorLocale, type Proyecto } from '../../../lib/proyectos';

interface Props {
  proyecto: Proyecto;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const paths = [];
  for (const lang of LOCALES_ACTIVOS) {
    const proyectos = await proyectosPorLocale(lang);
    for (const proyecto of proyectos) {
      paths.push({
        params: { lang, seccion: segmento(lang, 'proyectos'), slug: proyecto.data.slug },
        props: { proyecto },
      });
    }
  }
  return paths;
};

const { proyecto } = Astro.props;
const locale = localeDeEntrada(proyecto);
const t = useTranslations(locale);
const { Content } = await render(proyecto);
---

<BaseLayout
  locale={locale}
  activa="proyectos"
  slug={proyecto.data.slug}
  titulo={proyecto.data.titulo}
  descripcion={proyecto.data.resumen}
>
  <Contenedor class="py-20">
    <h1 class="max-w-3xl text-4xl tracking-[-.02em] md:text-5xl">{proyecto.data.titulo}</h1>

    {/* FASE 3: barra de contexto, cita destacada, anterior/siguiente, relacionados y CTA. */}
    <dl class="mt-8 grid gap-6 text-sm sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt class="text-[11.5px] tracking-[.13em] text-texto-tenue uppercase">
          {t('proyectos.cliente')}
        </dt>
        <dd class="mt-1.5 text-texto-cuerpo dark:text-noche-cuerpo">{proyecto.data.cliente}</dd>
      </div>
      <div>
        <dt class="text-[11.5px] tracking-[.13em] text-texto-tenue uppercase">
          {t('proyectos.anio')}
        </dt>
        <dd class="mt-1.5 text-texto-cuerpo dark:text-noche-cuerpo">{proyecto.data.año}</dd>
      </div>
      <div>
        <dt class="text-[11.5px] tracking-[.13em] text-texto-tenue uppercase">
          {t('proyectos.rol')}
        </dt>
        <dd class="mt-1.5 text-texto-cuerpo dark:text-noche-cuerpo">{proyecto.data.rol}</dd>
      </div>
      <div>
        <dt class="text-[11.5px] tracking-[.13em] text-texto-tenue uppercase">
          {t('proyectos.herramientas')}
        </dt>
        <dd class="mt-1.5 text-texto-cuerpo dark:text-noche-cuerpo">
          {proyecto.data.herramientas.join(', ')}
        </dd>
      </div>
    </dl>

    <Content />
  </Contenedor>
</BaseLayout>
