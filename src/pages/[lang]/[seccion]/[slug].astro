---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BloqueCTA from '../../../components/BloqueCTA.astro';
import BotonCopiarMarkdown from '../../../components/BotonCopiarMarkdown.astro';
import Contenedor from '../../../components/Contenedor.astro';
import Icono from '../../../components/Icono.astro';
import PozoImagen from '../../../components/PozoImagen.astro';
import TarjetaProyecto from '../../../components/TarjetaProyecto.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { rutaDe, segmento, useTranslations } from '../../../i18n/utils';
import { etiquetaCategoria } from '../../../lib/categorias';
import { jsonLdCaso } from '../../../lib/jsonld';
import { markdownDeCaso, rutaMarkdownDeCaso } from '../../../lib/markdown-caso';
import { rutaOg } from '../../../lib/og';
import {
  esAnioSuelto,
  localeDeEntrada,
  localesDeProyecto,
  proyectosPorLocale,
  proyectosRelacionados,
  vecinosDeProyecto,
  type Proyecto,
} from '../../../lib/proyectos';
import { siteDe } from '../../../lib/seo';
import { LOCALES_ACTIVOS } from '../../../i18n/ui';

interface Props {
  proyecto: Proyecto;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const paths = [];
  for (const lang of LOCALES_ACTIVOS) {
    const proyectos = await proyectosPorLocale(lang);
    for (const proyecto of proyectos) {
      paths.push({
        params: { lang, seccion: segmento(lang, 'proyectos'), slug: proyecto.data.slug },
        props: { proyecto },
      });
    }
  }
  return paths;
};

const { proyecto } = Astro.props;
const locale = localeDeEntrada(proyecto);
const t = useTranslations(locale);
const { Content, headings } = await render(proyecto);
const datos = proyecto.data;

// El índice reproduce los H2 del Markdown, en su orden de aparición.
const indice = headings.filter((encabezado) => encabezado.depth === 2);

const { anterior, siguiente } = await vecinosDeProyecto(proyecto);
const relacionados = await proyectosRelacionados(proyecto, 3);

/*
 * La barra de contexto. `lista` y `fecha` no cambian lo que se lee —el texto
 * visible es el mismo de siempre—, solo cómo queda representado en el DOM: las
 * herramientas dejan de ser una cadena con comas y pasan a ser una lista, y el
 * año lleva `<time datetime>` cuando de verdad es una fecha. Los dos son datos
 * que un rastreador tenía que adivinar partiendo texto.
 */
const contexto: { etiqueta: string; valor: string; lista?: string[]; fecha?: boolean }[] = [
  { etiqueta: t('proyectos.cliente'), valor: datos.cliente },
  { etiqueta: t('proyectos.anio'), valor: datos.año, fecha: esAnioSuelto(datos.año) },
  { etiqueta: t('proyectos.rol'), valor: datos.rol },
  {
    etiqueta: t('proyectos.herramientas'),
    valor: datos.herramientas.join(', '),
    lista: datos.herramientas,
  },
];

// Inicio › Proyectos › este caso. La última no lleva enlace: ya estás en ella.
const migas = [
  { texto: t('nav.inicio'), href: rutaDe(locale) },
  { texto: t('nav.proyectos'), href: rutaDe(locale, 'proyectos') },
  { texto: datos.titulo },
];

/*
 * Los idiomas en los que este caso existe como archivo, que son los únicos
 * cuya ruta genera el build. Sin esto el hreflang y el selector ofrecerían
 * /en/projects/<slug>/ para casos que todavía solo están en español.
 */
const localesDisponibles = await localesDeProyecto(datos.slug);
const site = siteDe(Astro.site);
const imagenOg = rutaOg(locale, 'caso', datos.slug);
const markdownCaso = markdownDeCaso(locale, proyecto, site);
// La misma ruta la usan el enlace visible y el `rel="alternate"` del head.
const rutaMarkdown = rutaMarkdownDeCaso(locale, datos.slug);
---

<BaseLayout
  locale={locale}
  activa="proyectos"
  slug={datos.slug}
  titulo={datos.titulo}
  descripcion={datos.resumen}
  tipo="article"
  imagenOg={imagenOg}
  jsonLd={jsonLdCaso(site, locale, proyecto, imagenOg)}
  localesDisponibles={localesDisponibles}
  markdownAlterno={rutaMarkdown}
>
  {/* --- Encabezado del caso --- */}
  <Contenedor class="pt-12 md:pt-14">
    {/*
      Las migas sustituyen al «← Todos los proyectos»: hacen el mismo trabajo
      —volver a la grilla— y además ponen a la vista la jerarquía que el
      BreadcrumbList del JSON-LD ya declaraba sin contraparte visible.
    */}
    <nav aria-label={t('nav.migas')} class="mb-7">
      <ol
        class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13.5px] text-texto-suave dark:text-noche-cuerpo"
      >
        {
          migas.map((miga, indice) => (
            <li class="flex min-w-0 items-center gap-x-2">
              {indice > 0 && <span aria-hidden="true">›</span>}
              {miga.href ? (
                <a
                  href={miga.href}
                  class="transition-colors hover:text-acento-texto dark:hover:text-menta"
                >
                  {miga.texto}
                </a>
              ) : (
                /* `truncate` es solo visual: el título completo sigue entero en
                   el DOM, que es lo que leen el rastreador y el lector de
                   pantalla. Sin él, un título largo ocupaba tres renglones a
                   360 px, más de lo que ocupaba el enlace al que sustituye. */
                <span aria-current="page" class="truncate text-bosque dark:text-noche-texto">
                  {miga.texto}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    {/*
      Una lista y no una cadena unida: son varias categorías, y el ` · ` es
      separación visual, no parte de ningún nombre. El `<span>` con el punto
      reproduce exactamente el texto que producía el `join(' · ')`.
    */}
    <ul
      class="inline-block rounded-full bg-acento/10 px-3 py-[5px] text-xs font-semibold text-profundo dark:bg-menta/12 dark:text-noche-enfasis"
    >
      {
        datos.categoria.map((cat, indice) => (
          <li class="inline">
            {indice > 0 && <span aria-hidden="true">{' · '}</span>}
            {etiquetaCategoria(locale, cat)}
          </li>
        ))
      }
    </ul>

    <h1
      class="mt-5 max-w-[860px] text-[34px] leading-[1.08] tracking-[-.025em] sm:text-[44px] lg:text-[56px]"
    >
      {datos.titulo}
    </h1>

    <p
      class="mt-5 max-w-[640px] text-[17px] leading-relaxed font-light text-texto-cuerpo sm:text-[19px] dark:text-noche-cuerpo"
    >
      {datos.resumen}
    </p>

    {
      /* La portada es el elemento LCP del caso: `astro:assets` la marcaría
         `lazy` y con eso el navegador la descubre tarde. */
      datos.imagen_portada ? (
        <Image
          src={datos.imagen_portada}
          alt={datos.imagen_alt ?? ''}
          widths={[720, 1200]}
          sizes="(min-width: 1280px) 1120px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="mt-11 h-[240px] w-full rounded-bloque object-cover sm:h-[340px] lg:h-[460px]"
        />
      ) : (
        <PozoImagen
          texto={t('proyectos.imagenPendiente')}
          class="mt-11 h-[240px] rounded-bloque sm:h-[340px] lg:h-[460px]"
        />
      )
    }
  </Contenedor>

  {/* --- Barra de contexto --- */}
  <Contenedor class="pt-7">
    <dl
      class="grid gap-6 rounded-tarjeta-sm border border-borde-medio bg-superficie px-[30px] py-[26px] sm:grid-cols-2 lg:grid-cols-4 dark:border-borde-noche dark:bg-noche-superficie"
    >
      {
        contexto.map((campo) => (
          <div>
            <dt class="mb-[7px] text-[11.5px] tracking-[.13em] text-texto-tenue uppercase dark:text-noche-cuerpo">
              {campo.etiqueta}
            </dt>
            <dd class="text-[14.5px] font-medium text-bosque dark:text-noche-texto">
              {campo.lista ? (
                <ul class="inline">
                  {campo.lista.map((herramienta, indice) => (
                    <li class="inline">
                      {indice > 0 && <span aria-hidden="true">{', '}</span>}
                      {herramienta}
                    </li>
                  ))}
                </ul>
              ) : campo.fecha ? (
                <time datetime={campo.valor}>{campo.valor}</time>
              ) : (
                campo.valor
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </Contenedor>

  {/* --- El caso en Markdown: copiarlo o abrirlo --- */}
  <Contenedor class="pt-6">
    <div class="flex flex-wrap items-center gap-3">
      <BotonCopiarMarkdown
        markdown={markdownCaso}
        etiqueta={t('proyectos.copiarMarkdown')}
        etiquetaCopiado={t('proyectos.copiarMarkdownListo')}
        etiquetaError={t('proyectos.copiarMarkdownError')}
      />
      {/*
        Un enlace de verdad al mismo archivo que ya anunciaba el `rel="alternate"`
        del head. Es `<a>` y no `<button>` a propósito: funciona sin JS, se abre
        en pestaña nueva con el clic del medio y deja un enlace interno rastreable
        hacia el .md.

        Abre en otra pestaña por decisión de Juan Camilo: el .md es texto plano
        que el navegador muestra desnudo, y volver al caso no debería depender
        del botón atrás. Eso obliga a las otras dos piezas: la flecha de enlace
        externo, que lo avisa a la vista, y la coletilla `sr-only`, que lo avisa
        a quien no la ve. Va detrás del texto, no como aria-label, para que el
        nombre accesible siga empezando por lo que se lee.
      */}
      <a
        href={rutaMarkdown}
        target="_blank"
        rel="noopener"
        class="inline-flex shrink-0 items-center gap-2 rounded-full border border-borde-medio px-4 py-2.5 text-[13.5px] font-medium text-bosque transition-colors hover:border-acento hover:text-acento-texto dark:border-borde-noche dark:text-noche-texto dark:hover:border-menta dark:hover:text-menta"
      >
        <Icono nombre="ojo" tamano={15} />
        {t('proyectos.verMarkdown')}
        <span class="sr-only">{t('proyectos.nuevaPestana')}</span>
        <Icono nombre="enlace-externo" tamano={13} class="opacity-70" />
      </a>

      {/*
        Explica qué hacen los dos botones de arriba: quien recluta no tiene
        por qué saber qué es un LLM ni por qué un proyecto tendría un botón
        para "copiarlo". El texto completo va en el `aria-label` del botón,
        así que quien usa lector de pantalla lo recibe al enfocarlo sin
        depender del tooltip visual, que por eso queda `aria-hidden`.
      */}
      <span class="group relative inline-flex">
        <button
          type="button"
          aria-label={t('proyectos.infoMarkdown')}
          class="grid size-7 shrink-0 place-items-center rounded-full border border-borde-medio text-texto-suave transition-colors hover:border-acento hover:text-acento-texto dark:border-borde-noche dark:text-noche-cuerpo dark:hover:border-menta dark:hover:text-menta"
        >
          <Icono nombre="info" tamano={14} />
        </button>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute top-full right-0 z-20 mt-2 w-max max-w-[min(240px,calc(100vw-2rem))] rounded-[10px] border border-borde-medio bg-superficie px-3 py-2 text-xs leading-relaxed text-texto-cuerpo opacity-0 shadow-flotante transition-opacity group-hover:opacity-100 group-focus-within:opacity-100 dark:border-borde-noche dark:bg-noche-flotante dark:text-noche-cuerpo dark:shadow-flotante-noche"
        >
          {t('proyectos.infoMarkdown')}
        </span>
      </span>
    </div>
  </Contenedor>

  {/* --- Cuerpo --- */}
  <Contenedor as="article" class="grid items-start gap-14 pt-14 lg:grid-cols-[220px_1fr] lg:pt-[72px]">
    {
      indice.length > 0 && (
        // En móvil el índice se oculta: el contenido queda a un scroll de distancia.
        <nav
          aria-label={t('proyectos.contenido')}
          class="sticky top-[110px] hidden flex-col gap-[11px] lg:flex"
        >
          <span class="mb-1 text-[11.5px] tracking-[.13em] text-texto-tenue uppercase dark:text-noche-cuerpo">
            {t('proyectos.contenido')}
          </span>
          {indice.map((encabezado) => (
            <a
              href={`#${encabezado.slug}`}
              class="text-[13.5px] text-texto-suave transition-colors hover:text-acento-texto dark:text-noche-cuerpo dark:hover:text-menta"
            >
              {encabezado.text}
            </a>
          ))}
        </nav>
      )
    }

    <div class="max-w-[680px]">
      <div class="prosa">
        <Content />
      </div>

      {
        datos.cita && (
          <figure class="ondas [--ondas-radio:40px] [--ondas-x:6%] [--ondas-y:100%] mt-14 rounded-tarjeta bg-pozo px-8 py-9 sm:px-10 dark:bg-noche-superficie">
            <blockquote class="font-titular text-[22px] leading-[1.4] tracking-[-.01em] text-profundo italic sm:text-[27px] dark:text-noche-titulo">
              {`“${datos.cita}”`}
            </blockquote>
            {datos.cita_autor && (
              <figcaption class="mt-[18px] text-[13.5px] tracking-[.02em] text-texto-suave dark:text-noche-cuerpo">
                — {datos.cita_autor}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>
  </Contenedor>

  {/* --- Anterior / siguiente --- */}
  {
    (anterior || siguiente) && (
      <Contenedor class="pt-14 md:pt-[88px]">
        <nav aria-label={t('proyectos.relacionados')} class="grid gap-5 sm:grid-cols-2">
          {anterior && (
            <a
              href={rutaDe(locale, 'proyectos', anterior.data.slug)}
              class="rounded-tarjeta-sm border border-borde-medio bg-superficie px-[30px] py-[26px] transition-colors hover:border-acento sm:col-start-1 dark:border-borde-noche dark:bg-noche-superficie dark:hover:border-menta"
            >
              <span class="mb-2 block text-xs text-texto-tenue dark:text-noche-cuerpo">
                ← {t('proyectos.anterior')}
              </span>
              <span class="font-titular text-xl text-profundo dark:text-noche-titulo">
                {anterior.data.titulo}
              </span>
            </a>
          )}
          {siguiente && (
            <a
              href={rutaDe(locale, 'proyectos', siguiente.data.slug)}
              class="rounded-tarjeta-sm border border-borde-medio bg-superficie px-[30px] py-[26px] text-right transition-colors hover:border-acento sm:col-start-2 dark:border-borde-noche dark:bg-noche-superficie dark:hover:border-menta"
            >
              <span class="mb-2 block text-xs text-texto-tenue dark:text-noche-cuerpo">
                {t('proyectos.siguiente')} →
              </span>
              <span class="font-titular text-xl text-profundo dark:text-noche-titulo">
                {siguiente.data.titulo}
              </span>
            </a>
          )}
        </nav>
      </Contenedor>
    )
  }

  {/* --- Relacionados --- */}
  {
    relacionados.length > 0 && (
      <Contenedor as="section" class="pt-14 md:pt-[72px]">
        <h2 class="mb-7 text-[26px] sm:text-[30px]">{t('proyectos.relacionados')}</h2>
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relacionados.map((relacionado) => (
            <li>
              <TarjetaProyecto proyecto={relacionado} locale={locale} variante="compacta" />
            </li>
          ))}
        </ul>
      </Contenedor>
    )
  }

  {/* --- CTA --- */}
  <Contenedor class="pt-14 md:pt-20">
    <BloqueCTA locale={locale} variante="compacto" id="contacto" />
  </Contenedor>
</BaseLayout>
