---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contenedor from '../../components/Contenedor.astro';
import MarcaGeometrica from '../../components/MarcaGeometrica.astro';
import { pathsDeLocalesActivos, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

export const getStaticPaths = pathsDeLocalesActivos;

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  activa="inicio"
  titulo={t('meta.inicio.titulo')}
  descripcion="[PENDIENTE: meta description de la portada]"
>
  <section
    class="ondas [--ondas-radio:46px] [--ondas-x:88%] [--ondas-y:12%] relative overflow-hidden"
  >
    <Contenedor class="py-24">
      <MarcaGeometrica class="mb-8 text-acento/60" />
      <h1 class="max-w-3xl text-4xl leading-[1.06] tracking-[-.025em] md:text-6xl">
        {t('meta.inicio.titulo')}
      </h1>
      <p class="mt-6 max-w-xl text-lg font-light text-texto-cuerpo dark:text-noche-cuerpo">
        [PENDIENTE: hero, prueba social, destacados, qué hago, proceso y CTA — FASE 3]
      </p>
    </Contenedor>
  </section>
</BaseLayout>
