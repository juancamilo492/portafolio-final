---
import AvisoPendiente from '../../components/AvisoPendiente.astro';
import BloqueCTA from '../../components/BloqueCTA.astro';
import Boton from '../../components/Boton.astro';
import Contenedor from '../../components/Contenedor.astro';
import Icono from '../../components/Icono.astro';
import MarcaGeometrica from '../../components/MarcaGeometrica.astro';
import MenuCV from '../../components/MenuCV.astro';
import TarjetaProyecto from '../../components/TarjetaProyecto.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import retrato from '../../assets/retratos/hero-juan-camilo.webp';
import { pathsDeLocalesActivos, rutaDe, useTranslations } from '../../i18n/utils';
import { jsonLdInicio } from '../../lib/jsonld';
import { rutaOg } from '../../lib/og';
import { proyectosDestacados } from '../../lib/proyectos';
import { siteDe } from '../../lib/seo';
import { linkedinDe, SITIO } from '../../config/sitio';
import type { NombreIcono } from '../../components/Icono.astro';
import type { Locale } from '../../i18n/ui';

export const getStaticPaths = pathsDeLocalesActivos;

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

// Vacío mientras el idioma no tenga casos: la sección lo resuelve con un
// marcador, no con relleno.
const destacados = await proyectosDestacados(locale, 3);

// El texto del enlace es la dirección limpia; el `?locale=` solo va en el href.
const perfilLinkedin = SITIO.linkedin.replace(/^https?:\/\/(www\.)?/, '');

const queHago: { icono: NombreIcono; titulo: string; texto: string }[] = [
  { icono: 'panel', titulo: t('inicio.queHago.1.titulo'), texto: t('inicio.queHago.1.texto') },
  { icono: 'chispa', titulo: t('inicio.queHago.2.titulo'), texto: t('inicio.queHago.2.texto') },
  { icono: 'ojo', titulo: t('inicio.queHago.3.titulo'), texto: t('inicio.queHago.3.texto') },
];

const proceso = [
  { numero: '01', titulo: t('inicio.proceso.1.titulo'), texto: t('inicio.proceso.1.texto') },
  { numero: '02', titulo: t('inicio.proceso.2.titulo'), texto: t('inicio.proceso.2.texto') },
  { numero: '03', titulo: t('inicio.proceso.3.titulo'), texto: t('inicio.proceso.3.texto') },
];
---

<BaseLayout
  locale={locale}
  activa="inicio"
  titulo={t('meta.inicio.titulo')}
  descripcion={t('meta.inicio.descripcion')}
  imagenOg={rutaOg(locale, 'inicio')}
  jsonLd={jsonLdInicio(siteDe(Astro.site), locale)}
>
  {/*
    --- Hero ---
    El recorte es `overflow-x-clip` y no `overflow-hidden` porque el menú del
    botón «Descargar CV» se despliega hacia abajo y cruza el borde inferior de
    esta sección: con `hidden` quedaba cortado y solo se veía el filo superior
    de la caja. `clip` es el único valor que permite recortar un eje y dejar el
    otro visible (`hidden` en un eje convierte el otro en `auto`), así que la
    sección sigue protegida contra el desbordamiento horizontal, que es de lo
    que se defendía.
  */}
  <section class="ondas [--ondas-radio:46px] [--ondas-x:88%] [--ondas-y:12%] relative overflow-x-clip">
    <Contenedor class="grid items-center gap-14 py-16 md:py-20 lg:grid-cols-[1.05fr_.95fr] lg:gap-14 lg:pt-24 lg:pb-22">
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-acento/35 bg-acento/8 py-[7px] pr-3.5 pl-[11px] text-[12.5px] font-medium text-profundo dark:border-menta/35 dark:bg-menta/10 dark:text-noche-enfasis"
        >
          <span
            aria-hidden="true"
            class="size-[7px] animate-punto rounded-full bg-acento dark:bg-menta"></span>
          {t('inicio.badge')}
        </span>

        <p
          class="mt-4 text-xs font-semibold tracking-[.12em] text-acento-texto uppercase sm:text-[13px] dark:text-menta"
        >
          {t('inicio.kicker')}
        </p>

        <h1
          class="mt-3 text-[40px] leading-[1.04] tracking-[-.025em] sm:text-[52px] lg:text-[66px]"
        >
          {t('inicio.h1.parte1')}{' '}
          {/* El acento puro no llega a AA en texto: aquí va la variante para texto grande. */}
          <em class="italic text-acento-hover dark:text-menta">
            {t('inicio.h1.enfasis')}
          </em>
        </h1>

        <p
          class="mt-6 max-w-[480px] text-[19px] leading-relaxed font-light text-texto-cuerpo dark:text-noche-cuerpo"
        >
          {t('inicio.subtitulo')}
        </p>

        <div class="mt-9 flex flex-wrap gap-3.5">
          <Boton href={rutaDe(locale, 'proyectos')}>{t('inicio.verProyectos')}</Boton>
          <Boton href="#contacto" variante="contorno">{t('inicio.hablemos')}</Boton>
          <MenuCV locale={locale} />
        </div>

        <a
          href={linkedinDe(locale)}
          rel="me noopener"
          target="_blank"
          class="mt-8 inline-flex items-center gap-2 text-[13px] text-texto-suave transition-colors hover:text-acento-texto dark:text-noche-cuerpo dark:hover:text-menta"
        >
          <Icono nombre="linkedin" tamano={14} />
          {perfilLinkedin}
        </a>

        <a
          href="#destacados"
          class="mt-12 flex items-center gap-[11px] text-xs font-semibold tracking-[.14em] text-texto-suave uppercase transition-colors hover:text-acento-texto dark:text-noche-cuerpo dark:hover:text-menta"
        >
          <span
            aria-hidden="true"
            class="grid size-[30px] animate-scroll place-items-center rounded-full border border-borde-medio dark:border-borde-noche"
          >
            <Icono nombre="flecha-abajo" tamano={13} />
          </span>
          {t('inicio.miraProyectos')}
        </a>
      </div>

      {/* Ancho tope en una sola columna: el retrato no debe volverse una torre. */}
      <div class="relative mx-auto w-full max-w-[420px] lg:mx-0 lg:max-w-none">
        <div
          aria-hidden="true"
          class="absolute top-[6%] right-[-4%] bottom-[-6%] left-[6%] rounded-cta bg-[linear-gradient(160deg,var(--color-profundo),var(--color-bosque))]"
        >
        </div>
        <MarcaGeometrica
          tamano={26}
          class="absolute -top-3.5 -left-1.5 z-[3] text-acento dark:text-menta"
        />
        {/* La única imagen sobre la línea de flotación: se carga con prioridad. */}
        <Image
          src={retrato}
          alt={t('inicio.retratoAlt')}
          widths={[420, 640, 1010]}
          sizes="(min-width: 1024px) 505px, (min-width: 640px) 420px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="retrato-bn relative z-[2] aspect-[4/4.6] w-full rounded-[22px] object-cover"
        />
      </div>
    </Contenedor>
  </section>

  {/* --- Franja de prueba social --- */}
  <section class="border-y border-borde-sutil bg-profundo/2 dark:border-borde-noche dark:bg-menta/4">
    <Contenedor class="flex items-center gap-3.5 py-[22px]">
      <MarcaGeometrica tamano={15} class="shrink-0 text-jade dark:text-menta" />
      <p class="text-sm text-texto-cuerpo dark:text-noche-cuerpo">{t('inicio.pruebaSocial')}</p>
    </Contenedor>
  </section>

  {/* --- Proyectos destacados --- */}
  <section id="destacados" class="scroll-mt-24">
    <Contenedor class="pt-[72px] md:pt-[92px]">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-[30px] tracking-[-.02em] sm:text-[40px]">{t('inicio.destacados')}</h2>
        <a
          href={rutaDe(locale, 'proyectos')}
          class="inline-flex items-center gap-2 text-sm font-semibold text-acento-texto transition-colors hover:text-profundo dark:text-menta dark:hover:text-noche-titulo"
        >
          {t('inicio.verTodos')}
          <Icono nombre="flecha-derecha" tamano={15} />
        </a>
      </div>

      {
        destacados.length === 0 ? (
          <AvisoPendiente texto={t('inicio.destacadosPendiente')} />
        ) : (
          <ul class="grid gap-[26px] sm:grid-cols-2 lg:grid-cols-3">
            {destacados.map((proyecto) => (
              <li>
                <TarjetaProyecto proyecto={proyecto} locale={locale} variante="destacada" />
              </li>
            ))}
          </ul>
        )
      }
    </Contenedor>
  </section>

  {/* --- Qué hago --- */}
  <Contenedor as="section" class="pt-[72px] md:pt-[92px]">
    <h2 class="mb-10 text-[30px] tracking-[-.02em] sm:text-[40px]">{t('inicio.queHago')}</h2>
    <ul class="grid gap-[26px] sm:grid-cols-2 lg:grid-cols-3">
      {
        queHago.map((tarjeta) => (
          <li class="ondas [--ondas-radio:40px] [--ondas-x:100%] [--ondas-y:0%] [--ondas-color:rgb(0_189_123_/_0.075)] rounded-tarjeta border border-borde bg-superficie px-[30px] pt-[34px] pb-[38px] dark:border-borde-noche dark:bg-noche-superficie">
            <Icono nombre={tarjeta.icono} tamano={22} class="text-acento-texto dark:text-menta" />
            <h3 class="mt-5 mb-2.5 text-[21px]">{tarjeta.titulo}</h3>
            <p class="text-sm leading-relaxed font-light text-texto-suave dark:text-noche-cuerpo">
              {tarjeta.texto}
            </p>
          </li>
        ))
      }
    </ul>
  </Contenedor>

  {/* --- Mi proceso --- */}
  <Contenedor as="section" class="pt-[72px] md:pt-[92px]">
    <h2 class="mb-10 text-[30px] tracking-[-.02em] sm:text-[40px]">{t('inicio.proceso')}</h2>
    <ol
      class="grid border-t border-borde-medio sm:grid-cols-3 dark:border-borde-noche"
    >
      {
        proceso.map((paso, indice) => (
          <li
            class:list={[
              'border-b border-borde py-[34px] sm:border-b-0 dark:border-borde-noche',
              indice === 0 && 'sm:border-r sm:pr-8',
              indice === 1 && 'sm:border-r sm:px-8',
              indice === 2 && 'sm:pl-8',
            ]}
          >
            <span
              aria-hidden="true"
              class="font-titular text-sm tracking-[.14em] text-acento-texto dark:text-menta"
            >
              {paso.numero}
            </span>
            <h3 class="mt-3 mb-2.5 text-[26px]">{paso.titulo}</h3>
            <p class="text-sm leading-relaxed font-light text-texto-suave dark:text-noche-cuerpo">
              {paso.texto}
            </p>
          </li>
        ))
      }
    </ol>
  </Contenedor>

  {/* --- Conóceme --- */}
  {/*
    Mini-sección propia, no solo un botón suelto: entre "Mi proceso" y el CTA
    final es donde quien lee ya conoce el trabajo y falta el empujón hacia la
    persona. Un botón sin nada alrededor se perdía entre dos secciones con
    título propio.
  */}
  <Contenedor as="section" class="pt-[72px] md:pt-[92px]">
    <div
      class="ondas [--ondas-radio:44px] [--ondas-x:6%] [--ondas-y:50%] [--ondas-color:rgb(0_189_123_/_0.06)] flex flex-col items-center gap-4 rounded-tarjeta border border-borde bg-superficie px-6 py-12 text-center sm:px-14 dark:border-borde-noche dark:bg-noche-superficie"
    >
      <MarcaGeometrica tamano={20} class="text-acento dark:text-menta" />
      <h2 class="text-[26px] tracking-[-.02em] sm:text-[32px]">{t('inicio.conocerMas.titulo')}</h2>
      <p class="max-w-[440px] text-[15px] leading-relaxed font-light text-texto-suave dark:text-noche-cuerpo">
        {t('inicio.conocerMas.texto')}
      </p>
      <Boton href={rutaDe(locale, 'sobreMi')} variante="contorno" class="mt-2">
        {t('inicio.conocerMas')}
      </Boton>
    </div>
  </Contenedor>

  {/* --- CTA final --- */}
  <Contenedor class="pt-[72px] md:pt-[92px]">
    <BloqueCTA locale={locale} id="contacto" />
  </Contenedor>
</BaseLayout>
