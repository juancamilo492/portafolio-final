---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contenedor from '../../components/Contenedor.astro';
import { pathsDePagina, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

// Solo genera Sobre mí: /es/sobre-mi/, /en/about/
export const getStaticPaths = () => pathsDePagina('sobreMi');

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  activa="sobreMi"
  titulo={t('meta.sobreMi.titulo')}
  descripcion="[PENDIENTE: meta description de Sobre mí]"
>
  <Contenedor class="py-20">
    <h1 class="text-4xl tracking-[-.02em] md:text-5xl">{t('meta.sobreMi.titulo')}</h1>
    <p class="mt-6 max-w-xl font-light text-texto-cuerpo dark:text-noche-cuerpo">
      [PENDIENTE: historia, habilidades agrupadas, educación, idiomas y CV — FASE 3]
    </p>
  </Contenedor>
</BaseLayout>
