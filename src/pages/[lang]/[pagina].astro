---
import BloqueCTA from '../../components/BloqueCTA.astro';
import Contenedor from '../../components/Contenedor.astro';
import IconoHerramienta from '../../components/IconoHerramienta.astro';
import MarcaGeometrica from '../../components/MarcaGeometrica.astro';
import MenuCV from '../../components/MenuCV.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import retrato from '../../assets/retratos/sobre-mi-juan-camilo.webp';
import { pathsDePagina, useTranslations } from '../../i18n/utils';
import { jsonLdSobreMi } from '../../lib/jsonld';
import { rutaOg } from '../../lib/og';
import { gruposDeHabilidades, idiomasVisibles } from '../../lib/perfil';
import { conMarca, siteDe } from '../../lib/seo';
import type { Locale } from '../../i18n/ui';

// Solo genera Sobre mí: /es/sobre-mi/, /en/about/
export const getStaticPaths = () => pathsDePagina('sobreMi');

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

/*
 * Habilidades e idiomas viven en `src/lib/perfil.ts`, no aquí: desde FASE 11
 * el nodo Person los declara como `knowsAbout` y `knowsLanguage`, y los datos
 * estructurados no pueden afirmar nada que esta página no muestre. Una sola
 * lista para las dos cosas es la única forma de que no se separen.
 */
const habilidades = gruposDeHabilidades(locale);
const idiomas = idiomasVisibles(locale);
---

<BaseLayout
  locale={locale}
  activa="sobreMi"
  titulo={t('meta.sobreMi.titulo')}
  tituloDocumento={conMarca(t('meta.sobreMi.titulo'))}
  descripcion={t('meta.sobreMi.descripcion')}
  imagenOg={rutaOg(locale, 'sobreMi')}
  jsonLd={jsonLdSobreMi(siteDe(Astro.site), locale)}
>
  {/* --- Presentación --- */}
  {/* `overflow-x-clip`, no `overflow-hidden`: ver la nota del hero de la portada. */}
  <section class="ondas [--ondas-radio:48px] [--ondas-x:92%] [--ondas-y:8%] overflow-x-clip">
    <Contenedor class="grid items-start gap-12 pt-14 pb-4 md:pt-[72px] lg:grid-cols-[1.05fr_.85fr]">
      <div>
        <h1 class="text-[38px] tracking-[-.025em] sm:text-[46px] lg:text-[54px]">
          {t('meta.sobreMi.titulo')}
        </h1>
        {/*
          Los tres párrafos comparten la clase `.prosa` de los casos: mismo
          tamaño, mismo interlineado y, sobre todo, el mismo resaltado del
          `<strong>` sin escribir CSS aparte. `.prosa` se declara con `:where()`,
          así que `text-[17px]` gana sobre sus 16.5px. Van con `set:html` porque
          el resaltado viaja dentro de la cadena del diccionario.
        */}
        <div class="prosa mt-6 max-w-[560px] text-[17px] [&>p:last-child]:mb-0">
          <p set:html={t('sobreMi.intro')} />
          <p set:html={t('sobreMi.parrafo2')} />
          <p set:html={t('sobreMi.parrafo3')} />
        </div>

        <div class="mt-8">
          <MenuCV locale={locale} />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[420px] lg:mx-0 lg:max-w-none">
        <MarcaGeometrica
          tamano={24}
          class="absolute -top-3 -left-1.5 z-[3] text-acento dark:text-menta"
        />
        <Image
          src={retrato}
          alt={t('sobreMi.retratoAlt')}
          widths={[420, 640, 960]}
          sizes="(min-width: 1024px) 480px, (min-width: 640px) 420px, 100vw"
          class="retrato-bn relative z-[2] aspect-[4/4.4] w-full rounded-[22px] object-cover"
        />
      </div>
    </Contenedor>
  </section>

  {/* --- Habilidades --- */}
  <Contenedor as="section" class="pt-[72px]">
    <h2 class="mb-8 text-[28px] tracking-[-.02em] sm:text-[34px]">{t('sobreMi.habilidades')}</h2>
    <div class="grid gap-8 sm:grid-cols-2">
      {
        habilidades.map((grupo) => (
          <div class:list={[grupo.completo && 'sm:col-span-2']}>
            <h3 class="mb-3.5 text-[11.5px] tracking-[.13em] text-texto-tenue uppercase dark:text-noche-cuerpo">
              {grupo.titulo}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {grupo.items.map((item) => (
                <li class="inline-flex items-center gap-[7px] rounded-full border border-borde-medio bg-superficie px-[13px] py-[7px] text-[13px] text-texto-cuerpo dark:border-borde-noche dark:bg-noche-superficie dark:text-noche-texto">
                  {item.icono && (
                    <IconoHerramienta
                      nombre={item.icono}
                      class="shrink-0 text-texto-tenue dark:text-noche-cuerpo"
                    />
                  )}
                  {item.texto}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Contenedor>

  {/* --- Educación e idiomas --- */}
  <Contenedor as="section" class="grid gap-8 pt-[72px] lg:grid-cols-2">
    <div
      class="rounded-tarjeta border border-borde bg-superficie px-8 py-9 dark:border-borde-noche dark:bg-noche-superficie"
    >
      <h2 class="text-[24px] tracking-[-.01em]">{t('sobreMi.educacion')}</h2>
      <p class="mt-5 text-[17px] font-medium text-bosque dark:text-noche-texto">
        {t('sobreMi.educacion.programa')}
      </p>
      <p class="mt-1.5 text-sm text-texto-cuerpo dark:text-noche-cuerpo">
        {t('sobreMi.educacion.institucion')} · {t('sobreMi.educacion.periodo')}
      </p>
      <p class="mt-1.5 text-sm text-texto-cuerpo dark:text-noche-cuerpo">
        {t('sobreMi.educacion.grado')} · {t('sobreMi.educacion.promedio')}
      </p>
      <p
        class="mt-4 inline-block rounded-full bg-acento/10 px-3.5 py-1.5 text-[13px] font-medium text-profundo dark:bg-menta/12 dark:text-noche-enfasis"
      >
        {t('sobreMi.educacion.distincion')}
      </p>
    </div>

    <div
      class="rounded-tarjeta border border-borde bg-superficie px-8 py-9 dark:border-borde-noche dark:bg-noche-superficie"
    >
      <h2 class="text-[24px] tracking-[-.01em]">{t('sobreMi.idiomas')}</h2>
      <ul class="mt-5 flex flex-col gap-3">
        {
          idiomas.map((idioma) => (
            <li class="flex items-center gap-3 text-[15px] text-texto-cuerpo dark:text-noche-cuerpo">
              <span aria-hidden="true" class="size-1.5 rounded-full bg-acento dark:bg-menta" />
              {idioma}
            </li>
          ))
        }
      </ul>
    </div>
  </Contenedor>

  {/* --- CTA --- */}
  <Contenedor class="pt-[72px] md:pt-[92px]">
    <BloqueCTA locale={locale} variante="compacto" id="contacto" />
  </Contenedor>
</BaseLayout>
