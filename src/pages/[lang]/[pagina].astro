---
import BloqueCTA from '../../components/BloqueCTA.astro';
import Contenedor from '../../components/Contenedor.astro';
import MarcaGeometrica from '../../components/MarcaGeometrica.astro';
import MenuCV from '../../components/MenuCV.astro';
import PozoImagen from '../../components/PozoImagen.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pathsDePagina, useTranslations } from '../../i18n/utils';
import { etiquetaCategoria } from '../../lib/categorias';
import type { Locale } from '../../i18n/ui';

// Solo genera Sobre mí: /es/sobre-mi/, /en/about/
export const getStaticPaths = () => pathsDePagina('sobreMi');

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

/**
 * Habilidades agrupadas, sin barras ni porcentajes (CLAUDE.md).
 * Todo lo que aparece aquí sale de los casos de estudio: herramientas de su
 * frontmatter y métodos descritos en el cuerpo. Nada declarativo inventado.
 */
const habilidades = [
  {
    titulo: t('sobreMi.habilidades.diseno'),
    items: [
      'Figma',
      'Blender',
      etiquetaCategoria(locale, 'UX/UI'),
      etiquetaCategoria(locale, 'Diseño de servicio'),
    ],
  },
  {
    titulo: t('sobreMi.habilidades.ia'),
    items: ['n8n', 'Leonardo AI', 'OpenCV', 'Looker Studio'],
  },
  {
    titulo: t('sobreMi.habilidades.desarrollo'),
    items: [
      'React',
      'TypeScript',
      'Next.js',
      'Tailwind CSS',
      'Supabase',
      'Python',
      'Three.js',
      'Unity',
      'ESP32',
      'Vercel',
    ],
  },
  {
    titulo: t('sobreMi.habilidades.metodologias'),
    items: [
      'Design Thinking',
      'UX Research',
      t('sobreMi.metodo.entrevistas'),
      t('sobreMi.metodo.pruebas'),
      t('sobreMi.metodo.prototipado'),
    ],
  },
];

const idiomas = [
  t('sobreMi.idiomas.es'),
  t('sobreMi.idiomas.en'),
  t('sobreMi.idiomas.fr'),
  t('sobreMi.idiomas.de'),
];
---

<BaseLayout
  locale={locale}
  activa="sobreMi"
  titulo={t('meta.sobreMi.titulo')}
  descripcion={t('meta.sobreMi.descripcion')}
>
  {/* --- Presentación --- */}
  <section class="ondas [--ondas-radio:48px] [--ondas-x:92%] [--ondas-y:8%] overflow-hidden">
    <Contenedor class="grid items-start gap-12 pt-14 pb-4 md:pt-[72px] lg:grid-cols-[1.05fr_.85fr]">
      <div>
        <h1 class="text-[38px] tracking-[-.025em] sm:text-[46px] lg:text-[54px]">
          {t('meta.sobreMi.titulo')}
        </h1>
        <p
          class="mt-6 max-w-[560px] text-[17px] leading-relaxed font-light text-texto-cuerpo sm:text-[19px] dark:text-noche-cuerpo"
        >
          {t('sobreMi.intro')}
        </p>
        <p
          class="mt-4 max-w-[560px] text-[16.5px] leading-[1.75] font-light text-texto-cuerpo dark:text-noche-cuerpo"
        >
          {t('sobreMi.parrafo2')}
        </p>
        <p
          class="mt-6 max-w-[560px] rounded-tarjeta-sm border border-dashed border-borde-fuerte px-5 py-4 text-sm text-texto-suave dark:border-borde-noche dark:text-noche-cuerpo"
        >
          {t('sobreMi.parrafoPendiente')}
        </p>

        <div class="mt-8">
          <MenuCV locale={locale} />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[420px] lg:mx-0 lg:max-w-none">
        <MarcaGeometrica
          tamano={24}
          class="absolute -top-3 -left-1.5 z-[3] text-acento dark:text-menta"
        />
        {/* [PENDIENTE: segundo retrato — se integra con astro:assets en FASE 4] */}
        <PozoImagen
          texto={t('sobreMi.retratoPendiente')}
          class="retrato-bn relative z-[2] aspect-[4/4.4] overflow-hidden rounded-[22px]"
        />
      </div>
    </Contenedor>
  </section>

  {/* --- Habilidades --- */}
  <Contenedor as="section" class="pt-[72px]">
    <h2 class="mb-8 text-[28px] tracking-[-.02em] sm:text-[34px]">{t('sobreMi.habilidades')}</h2>
    <div class="grid gap-8 sm:grid-cols-2">
      {
        habilidades.map((grupo) => (
          <div>
            <h3 class="mb-3.5 text-[11.5px] tracking-[.13em] text-texto-tenue uppercase dark:text-noche-cuerpo">
              {grupo.titulo}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {grupo.items.map((item) => (
                <li class="rounded-full border border-borde-medio bg-superficie px-[13px] py-[7px] text-[13px] text-texto-cuerpo dark:border-borde-noche dark:bg-noche-superficie dark:text-noche-texto">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Contenedor>

  {/* --- Educación e idiomas --- */}
  <Contenedor as="section" class="grid gap-8 pt-[72px] lg:grid-cols-2">
    <div
      class="rounded-tarjeta border border-borde bg-superficie px-8 py-9 dark:border-borde-noche dark:bg-noche-superficie"
    >
      <h2 class="text-[24px] tracking-[-.01em]">{t('sobreMi.educacion')}</h2>
      <p class="mt-5 text-[17px] font-medium text-bosque dark:text-noche-texto">
        {t('sobreMi.educacion.programa')}
      </p>
      <p class="mt-1.5 text-sm text-texto-cuerpo dark:text-noche-cuerpo">
        {t('sobreMi.educacion.institucion')} · {t('sobreMi.educacion.periodo')}
      </p>
      <p
        class="mt-4 inline-block rounded-full bg-acento/10 px-3.5 py-1.5 text-[13px] font-medium text-profundo dark:bg-menta/12 dark:text-noche-enfasis"
      >
        {t('sobreMi.educacion.distincion')}
      </p>
    </div>

    <div
      class="rounded-tarjeta border border-borde bg-superficie px-8 py-9 dark:border-borde-noche dark:bg-noche-superficie"
    >
      <h2 class="text-[24px] tracking-[-.01em]">{t('sobreMi.idiomas')}</h2>
      <ul class="mt-5 flex flex-col gap-3">
        {
          idiomas.map((idioma) => (
            <li class="flex items-center gap-3 text-[15px] text-texto-cuerpo dark:text-noche-cuerpo">
              <span aria-hidden="true" class="size-1.5 rounded-full bg-acento dark:bg-menta" />
              {idioma}
            </li>
          ))
        }
      </ul>
    </div>
  </Contenedor>

  {/* --- CTA --- */}
  <Contenedor class="pt-[72px] md:pt-[92px]">
    <BloqueCTA locale={locale} variante="compacto" id="contacto" />
  </Contenedor>
</BaseLayout>
